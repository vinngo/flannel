# Flannel web app. Copy to .env.local.
# Env names match plaid-agent-mcp so both can share values.

# --- Agent -----------------------------------------------------------------
AGENT_MODE=stub              # stub | strands
# strands: Claude on Bedrock (Mantle) using the standard AWS credential chain
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
AGENT_EFFORT=medium          # low | medium | high
# plaid-agent-mcp's local server (npm run dev there)
MCP_URL=http://127.0.0.1:3000/mcp
MCP_API_KEY=                 # only if the MCP server sets one
# strands: AgentCore Code Interpreter for pandas analysis (same AWS credentials)
CODE_INTERPRETER_ID=aws.codeinterpreter.v1
CODE_INTERPRETER_TIMEOUT_SECONDS=900

# --- Plaid -----------------------------------------------------------------
# Blank = Link button disabled; chat still works.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_PRODUCTS=investments
PLAID_COUNTRY_CODES=US

# --- Tokens (create-only from the web app) ----------------------------------
# file: same encrypted format as plaid-agent-mcp, so its local server sees new links
# secrets-manager: one secret per Item at <prefix><itemId>
TOKEN_STORE=file
TOKEN_STORE_PATH=../plaid-agent-mcp/data/items.json
TOKEN_ENCRYPTION_KEY=        # 32+ chars; must match plaid-agent-mcp's value
PLAID_TOKEN_SECRET_PREFIX=plaid-agent/items/

# --- Snapshots (read by the agent) and session artifacts (sessions/<id>/...) --
ARTIFACT_STORE=local         # local | s3 (presigned URLs)
ARTIFACT_DIR=../plaid-agent-mcp/data/store
SNAPSHOT_BUCKET=             # required when ARTIFACT_STORE=s3
